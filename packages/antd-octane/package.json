{
  "name": "antd-octane",
  "version": "0.1.0-alpha.8",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/entry.ts"
    },
    "./style.css": "./src/style.css",
    "./icons": {
      "types": "./src/icons.tsx",
      "import": "./src/icons.tsx"
    },
    "./style": {
      "types": "./src/style/index.tsx",
      "import": "./src/style/index.tsx"
    },
    "./vite": {
      "types": "./src/vite.d.mts",
      "import": "./src/vite.mjs"
    }
  },
  "peerDependencies": {
    "octane": "0.4.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@ant-design/colors": "^7.2.1",
    "@ant-design/fast-color": "^2.0.6",
    "csstype": "^3.1.3",
    "dayjs": "1.11.23"
  },
  "description": "Ant Design-style native components and themes for Octane.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoderSerio/antd-octane.git",
    "directory": "packages/antd-octane"
  },
  "homepage": "https://coderserio.github.io/antd-octane/",
  "bugs": {
    "url": "https://github.com/CoderSerio/antd-octane/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
