{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "octane",
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": { "antd-octane": ["./packages/antd-octane/src/index.ts"] }
  },
  "include": ["packages", "site", "tests", "vitest.config.ts"]
}
